{
  "name": "frontend",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3001",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "auth:generate": "pnpm dlx @better-auth/cli@latest generate --config src/features/auth/auth.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.10",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "better-auth": "1.7.10",
    "drizzle-orm": "0.45.4",
    "lucide-react": "0.545.0",
    "nitro": "3.0.260903-beta",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.34.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/eslint-config": "0.4.0",
    "@types/node": "22.19.15",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "jsdom": "28.1.0",
    "prettier": "3.9.10",
    "typescript": "6.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
}
