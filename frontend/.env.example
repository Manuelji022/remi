DATABASE_URL=postgres://app_user:replace-with-password@localhost:5432/app_db
# Optional postgres-js pool maximum; use PGMAX=1 to verify constrained-pool behavior.
# PGMAX=10
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3001
# Add the exact Tailscale browser origin here when using Vite --host.
BETTER_AUTH_TRUSTED_ORIGINS=
RESEND_API_KEY=re_replace-with-resend-api-key
OTP_EMAIL_FROM=Remi <auth@example.com>
DEV_SEED_USER_NAME=Local Developer
# Use an inbox you can access; login requires a one-time email code.
DEV_SEED_USER_EMAIL=your-accessible-email@example.com
DEV_SEED_USER_PASSWORD=replace-with-a-local-only-password
DEV_SEED_ALLOW_REMOTE_DATABASE=false
# Required on the VPS for weekly-menu generation; server-only Node/Nitro key.
# Never prefix with VITE_ or expose to the browser. No Vercel hosting/OIDC required.
AI_GATEWAY_API_KEY=replace-with-ai-gateway-api-key
# Optional decision model ID; default: openai/gpt-6-luna-decisions.
AI_WEEKLY_MENU_DECISION_MODEL=openai/gpt-6-luna-decisions
# Local development only: skip the AI provider and return a deterministic menu from saved recipes.
# AI_WEEKLY_MENU_MOCK=true
# Development only: /weekly-menu-planner?mock=ok (default), slow, error,
# rate-limited, in-progress, stale, or empty. Ignored in production.
